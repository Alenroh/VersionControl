                <h4>${reminder.title} <span class="priority-badge ${reminder.priority}">${reminder.priority.toUpperCase()}</span></h4>
                <p><strong>Description:</strong> ${reminder.description || 'No description'}</p>
                <p><strong>Due Date:</strong> ${reminder.dueDate || 'No due date'}</p>
                <p><strong>Added:</strong> ${reminder.timestamp}</p>
                <button class="delete-btn" onclick="deleteReminder(${reminder.id})">Delete</button>
            `;
            container.appendChild(reminderDiv);
        });
    }

    function deleteReminder(id) {
        let reminders = JSON.parse(localStorage.getItem('reminders')) || [];
        reminders = reminders.filter(reminder => reminder.id !== id);
        localStorage.setItem('reminders', JSON.stringify(reminders));
        loadReminders();
    }

    function clearAllReminders() {
        if (confirm('Are you sure you want to delete all reminders?')) {
            localStorage.removeItem('reminders');
            loadReminders();
        }
    }
</script>
